# Windows Audio Transcriber Configuration
# Host & Port for local USB forwarding (ADB)
HOST=127.0.0.1
PORT=8765

# Faster-Whisper Model Settings
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v3
MODEL_SIZE=tiny.en

# Device: cpu or cuda
DEVICE=cpu

# Compute type: int8, float16, float32, etc. (int8 recommended for CPU)
COMPUTE_TYPE=int8

# Transcription language (e.g. en, es, fr, or auto)
LANGUAGE=en

# Audio Capture Settings
SAMPLE_RATE=16000
CHUNK_DURATION_SEC=1.0
SILENCE_THRESHOLD=0.005
VAD_FILTER=true
MIN_SILENCE_DURATION_MS=500

# Speaker / Output device substring match (empty for default output)
DEVICE_NAME=
